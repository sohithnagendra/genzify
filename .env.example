# Copy these placeholders into your local environment as needed.
# Never put real credentials in this file or commit a real .env file.
APP_ENV=development
NVIDIA_API_KEY=replace-with-your-own-local-test-or-development-key

# Required when APP_ENV=production. Use a managed Redis URL configured in the host's secret settings.
# Example format only; do not commit actual credentials:
# REDIS_URL=rediss://username:password@your-redis-host:6379/0
REDIS_URL=
